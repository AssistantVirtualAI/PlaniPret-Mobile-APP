<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ── Recommandation Google Play #1 : Edge-to-edge (API 36) ───────────────
        Android 15+ (API 35+) force l'edge-to-edge pour toutes les apps.
        Les APIs windowTranslucentStatus / windowTranslucentNavigation sont
        dépréciées depuis API 35 et causent l'avertissement Play Console.

        Remplacement par la méthode recommandée :
        - android:windowOptOutEdgeToEdgeEnforcement="false" → accepte l'edge-to-edge
        - android:statusBarColor + android:navigationBarColor → transparents
        - android:windowDrawsSystemBarBackgrounds="true" → l'app dessine derrière
        La WebView Capacitor gère déjà env(safe-area-inset-*) via CSS.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Edge-to-edge : barre de statut et de navigation transparentes (API 35+) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Pas d'ActionBar native -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Theme for launch screen (no action bar, full screen) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
